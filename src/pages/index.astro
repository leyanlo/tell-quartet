---
const members = [
	{
		number: '01',
		name: 'Lynn Gerber',
		initials: 'LG',
		bio: 'A Bay Area violinist and concertmaster of the Stanford Medicine Orchestra, Lynn studied at the San Francisco Conservatory of Music and with Geoff Nuttall. Away from the stand, she is an anesthesiologist and clinical instructor.',
		profile: 'https://med.stanford.edu/medicineandthemuse/events/StanfordMedicineMusicNetwork/orchestra.html',
	},
	{
		number: '02',
		name: 'Leyan Lo',
		initials: 'LL',
		bio: 'An avid violinist who is happiest playing chamber music with friends, Leyan has performed widely at the St. Lawrence String Quartet Chamber Music Seminar. His other lives are in technology and speedcubing.',
		profile: 'https://www.leyanlo.com/violin/',
	},
	{
		number: '03',
		name: 'Tyson Mao',
		initials: 'TM',
		bio: 'A violinist and pianist with roots in the California Youth Symphony and Caltech ensembles, Tyson now serves as president of the CYS board. Beyond music, he is a technologist, entrepreneur, and speedcubing pioneer.',
		profile: 'https://www.cys.org/about/board.html',
	},
	{
		number: '04',
		name: 'Eric Kim',
		initials: 'EK',
		bio: 'A cellist and former member of the Yale Cellos, Eric brings a lifelong musical perspective to the quartet. Outside music, he is the co-founder and managing partner of Goodwater Capital.',
		profile: 'https://www.goodwatercap.com/team/eric-kim/',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Tell Quartet — four voices in conversation, based in the San Francisco Bay Area." />
		<meta name="theme-color" content="#e32b20" />
		<meta property="og:title" content="Tell Quartet" />
		<meta property="og:description" content="Four voices. One story." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://tell-quartet.leyanlo.com" />
		<meta name="twitter:card" content="summary" />
		<meta name="generator" content={Astro.generator} />
		<title>Tell Quartet — Four Voices, One Story</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="site-header wrap">
			<a class="logo" href="#top" aria-label="Tell Quartet, home"><span class="cross" aria-hidden="true"></span><span>Tell<br />Quartet</span></a>
			<nav aria-label="Main navigation">
				<a href="#about">About</a>
				<a href="#players">Players</a>
				<a href="#contact">Contact</a>
			</nav>
			<p class="location">San Francisco<br />Bay Area</p>
		</header>

		<main id="top">
			<section class="hero wrap" aria-labelledby="hero-title">
				<div class="hero-meta"><span>String Quartet</span><span>California · 2026</span></div>
				<h1 id="hero-title">TELL<span class="dot">.</span></h1>
				<div class="hero-foot">
					<p>Four voices.<br />One story.</p>
					<a href="#about" class="arrow-link"><span>Begin listening</span><i aria-hidden="true">↓</i></a>
				</div>
				<div class="target" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
			</section>

			<section class="manifesto" id="about" aria-labelledby="about-title">
				<div class="wrap section-grid">
					<p class="kicker"><span>01</span> About</p>
					<div class="manifesto-copy">
						<h2 id="about-title">Music is a story<br />we <em>tell together.</em></h2>
						<div class="columns">
							<p>A quartet is a conversation without small talk. Four independent voices meet in the same room—questioning, answering, interrupting, and finding their way toward a shared idea.</p>
							<p>Tell Quartet brings curiosity and close listening to music old and new. We believe the most memorable performances feel both inevitable and alive: precise in their aim, spontaneous in their telling.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="motto" aria-label="Tell Quartet motto">
				<div class="motto-track" aria-hidden="true"><span>Listen · Speak · Respond ·&nbsp;</span><span>Listen · Speak · Respond ·&nbsp;</span></div>
			</section>

			<section class="players wrap" id="players" aria-labelledby="players-title">
				<div class="players-head">
					<p class="kicker"><span>02</span> The players</p>
					<h2 id="players-title">Four parts,<br /><em>fully present.</em></h2>
					<p>Four Bay Area musicians, each with a life beyond rehearsal and a shared appetite for close listening.</p>
				</div>
				<div class="chair-grid">
					{members.map((member) => (
						<article class="chair">
							<div class="chair-portrait" aria-label={`Photo placeholder for ${member.name}`}>
								<span>{member.initials}</span>
								<div class="bow" aria-hidden="true"></div>
							</div>
							<div class="chair-info">
								<p class="member-number">{member.number}</p>
								<h3>{member.name}</h3>
								<p class="member-bio">{member.bio}</p>
								<a href={member.profile} target="_blank" rel="noreferrer">Public profile <span aria-hidden="true">↗</span></a>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="program" aria-labelledby="program-title">
				<div class="wrap section-grid">
					<p class="kicker light"><span>03</span> On the stand</p>
					<div>
						<h2 id="program-title">A repertoire<br />in <em>progress.</em></h2>
						<ul>
							<li><span>01</span><strong>Classical foundations</strong><i>Haydn to Ravel</i></li>
							<li><span>02</span><strong>Living voices</strong><i>Music of our time</i></li>
							<li><span>03</span><strong>Unexpected stories</strong><i>Arrangements & collaborations</i></li>
						</ul>
					</div>
				</div>
			</section>

			<section class="contact wrap" id="contact" aria-labelledby="contact-title">
				<p class="kicker"><span>04</span> Contact</p>
				<div class="contact-grid">
					<div>
						<h2 id="contact-title">Tell us<br /><em>everything.</em></h2>
						<p>Performance ideas, collaborations, and friendly hellos are all welcome.</p>
					</div>
					<form name="contact" method="POST" action="/success" data-netlify="true" netlify-honeypot="bot-field">
						<input type="hidden" name="form-name" value="contact" />
						<p class="hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>
						<label>Name<input type="text" name="name" autocomplete="name" required /></label>
						<label>Email<input type="email" name="email" autocomplete="email" required /></label>
						<label>Message<textarea name="message" rows="4" required></textarea></label>
						<button type="submit">Send message <span aria-hidden="true">↗</span></button>
					</form>
				</div>
			</section>
		</main>

		<footer class="wrap">
			<a class="logo" href="#top"><span class="cross" aria-hidden="true"></span><span>Tell<br />Quartet</span></a>
			<p>Four voices · One story</p>
			<p>© {new Date().getFullYear()} Tell Quartet</p>
		</footer>
	</body>
</html>

<style is:global>
	:root{--red:#e32b20;--cream:#f2eee2;--ink:#111211;--quiet:#7d7a72;--line:rgba(17,18,17,.22)}
	*{box-sizing:border-box}
	html{scroll-behavior:smooth;background:var(--cream)}
	body{margin:0;background:var(--cream);color:var(--ink);font-family:'Space Grotesk',sans-serif;line-height:1.5;overflow-x:hidden}
	a{color:inherit;text-decoration:none}
	.wrap{width:min(1440px,calc(100% - 72px));margin-inline:auto}
	.site-header{height:104px;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;border-bottom:1px solid rgba(242,238,226,.42);position:absolute;left:50%;transform:translateX(-50%);z-index:5;color:var(--cream)}
	.logo{display:flex;align-items:center;gap:14px;font-size:12px;line-height:1.05;font-weight:600;text-transform:uppercase;letter-spacing:.05em;width:max-content}
	.cross{width:27px;height:27px;background:currentColor;position:relative;display:block;clip-path:polygon(38% 0,62% 0,62% 38%,100% 38%,100% 62%,62% 62%,62% 100%,38% 100%,38% 62%,0 62%,0 38%,38% 38%)}
	nav{justify-self:center;display:flex;gap:34px;font-size:11px;text-transform:uppercase;letter-spacing:.11em}
	nav a{position:relative}nav a::after{content:"";position:absolute;height:1px;background:currentColor;left:0;right:100%;bottom:-4px;transition:.25s}nav a:hover::after{right:0}
	.location{justify-self:end;font-size:10px;line-height:1.25;text-align:right;text-transform:uppercase;letter-spacing:.12em}
	.hero{height:max(720px,100svh);background:var(--red);color:var(--cream);position:relative;padding:145px 0 55px;overflow:hidden}
	.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent calc(25% - 1px),rgba(242,238,226,.15) 25%,transparent calc(25% + 1px),transparent calc(50% - 1px),rgba(242,238,226,.15) 50%,transparent calc(50% + 1px),transparent calc(75% - 1px),rgba(242,238,226,.15) 75%,transparent calc(75% + 1px))}
	.hero-meta{display:flex;justify-content:space-between;font-size:10px;text-transform:uppercase;letter-spacing:.18em;position:relative;z-index:2}
	.hero h1{font-size:clamp(150px,27vw,430px);line-height:.68;letter-spacing:-.095em;margin:23vh 0 0 -18px;font-weight:600;position:relative;z-index:2}
	.dot{font-family:'Instrument Serif',serif;font-weight:400}
	.hero-foot{position:absolute;bottom:54px;left:0;right:0;display:flex;justify-content:space-between;align-items:end;padding:0 5px;z-index:2}
	.hero-foot>p{font-family:'Instrument Serif',serif;font-size:29px;line-height:.92;margin:0}
	.arrow-link{display:flex;align-items:center;gap:50px;border-bottom:1px solid currentColor;padding:0 0 12px;width:240px;justify-content:space-between;text-transform:uppercase;font-size:10px;letter-spacing:.14em}.arrow-link i{font-style:normal;font-size:18px}
	.target{width:min(31vw,470px);aspect-ratio:1;border-radius:50%;position:absolute;right:8.5%;top:16%;border:1px solid rgba(242,238,226,.28);display:grid;place-items:center}
	.target i{position:absolute;border:1px solid rgba(242,238,226,.28);border-radius:50%}.target i:nth-child(1){inset:14%}.target i:nth-child(2){inset:29%}.target i:nth-child(3){inset:43%}.target b{width:8px;height:8px;border-radius:50%;background:var(--cream)}
	.section-grid{display:grid;grid-template-columns:1fr 3fr;gap:30px}
	.kicker{font-size:10px;text-transform:uppercase;letter-spacing:.14em;margin:0;display:flex;gap:22px}.kicker span{color:var(--quiet)}
	.manifesto{padding:150px 0 140px}
	.manifesto h2,.players h2,.program h2,.contact h2{font-family:'Instrument Serif',serif;font-size:clamp(66px,8.2vw,125px);font-weight:400;line-height:.83;letter-spacing:-.045em;margin:0}
	h2 em{font-weight:400;color:var(--red)}
	.columns{display:grid;grid-template-columns:1fr 1fr;gap:12%;padding-left:25%;margin-top:78px}.columns p{max-width:420px;font-size:17px;margin:0}
	.motto{background:var(--ink);color:var(--cream);overflow:hidden;border-bottom:1px solid #333;padding:8px 0 17px}
	.motto-track{white-space:nowrap;display:flex;width:max-content;font-family:'Instrument Serif',serif;font-style:italic;font-size:clamp(90px,12vw,180px);line-height:1;letter-spacing:-.04em;animation:scroll 24s linear infinite}.motto-track span:nth-child(2){color:var(--red)}
	@keyframes scroll{to{transform:translateX(-50%)}}
	.players{padding:145px 0 160px}
	.players-head{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:end;margin-bottom:88px}.players-head>p:last-child{max-width:275px;font-size:14px;color:var(--quiet);margin:0 0 8px}
	.chair-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
	.chair{border-top:1px solid var(--ink);padding-top:12px}.chair-portrait{aspect-ratio:3/4;background:#ddd7c9;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
	.chair-portrait::before{content:"";position:absolute;width:64%;aspect-ratio:1;border:1px solid rgba(17,18,17,.28);border-radius:50%}
	.chair-portrait span{font-family:'Instrument Serif',serif;font-style:italic;font-size:clamp(90px,10vw,150px);color:#bbb4a7;letter-spacing:-.06em}
	.bow{height:140%;width:1px;background:var(--red);position:absolute;transform:rotate(32deg)}
	.chair:nth-child(even) .chair-portrait{background:var(--ink)}.chair:nth-child(even) .chair-portrait span{color:#333}.chair:nth-child(even) .chair-portrait::before{border-color:#484848}
	.chair-info{display:grid;grid-template-columns:34px 1fr;padding-top:15px}.chair h3{font-family:'Instrument Serif',serif;font-size:30px;line-height:1;font-weight:400;margin:0}.chair .member-number{font-size:9px;letter-spacing:.1em;color:var(--red);margin:5px 0 0}.chair .member-bio{grid-column:2;font-size:12px;line-height:1.55;color:var(--quiet);margin:17px 0 20px}.chair-info a{grid-column:2;width:max-content;font-size:9px;text-transform:uppercase;letter-spacing:.12em;border-bottom:1px solid var(--line);padding-bottom:4px}.chair-info a:hover{color:var(--red);border-color:var(--red)}
	.program{background:var(--ink);color:var(--cream);padding:145px 0}.kicker.light span{color:#777}
	.program h2 em{color:var(--red)}.program ul{list-style:none;padding:0;margin:90px 0 0}.program li{border-top:1px solid #444;display:grid;grid-template-columns:80px 1fr 1fr;align-items:center;padding:24px 0}.program li:last-child{border-bottom:1px solid #444}.program li span{font-size:10px;color:#777}.program strong{font-family:'Instrument Serif',serif;font-weight:400;font-size:32px}.program li i{font-style:normal;font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:#999;justify-self:end}
	.contact{padding:150px 0 120px}.contact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:12%;margin-top:75px}.contact-grid>div>p{max-width:360px;margin:40px 0 0;color:var(--quiet)}
	form{display:flex;flex-direction:column;gap:22px;padding-top:8px}form label{font-size:9px;text-transform:uppercase;letter-spacing:.14em;color:var(--quiet)}input,textarea{font:16px 'Space Grotesk',sans-serif;width:100%;background:transparent;border:0;border-bottom:1px solid var(--ink);padding:10px 0;border-radius:0;outline:none;resize:vertical}input:focus,textarea:focus{border-color:var(--red);box-shadow:0 1px var(--red)}button{border:0;background:var(--red);color:var(--cream);padding:19px 20px;text-transform:uppercase;letter-spacing:.13em;font:10px 'Space Grotesk',sans-serif;display:flex;justify-content:space-between;cursor:pointer;margin-top:8px;transition:.2s}button:hover{background:var(--ink)}.hidden{position:absolute;left:-9999px}
	footer{border-top:1px solid var(--ink);padding:28px 0 44px;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;font-size:9px;text-transform:uppercase;letter-spacing:.11em}footer p{margin:0}footer p:nth-child(2){text-align:center}footer p:last-child{text-align:right}
	@media(max-width:900px){.wrap{width:min(100% - 36px,1440px)}.site-header{height:80px}.site-header nav{display:none}.site-header{grid-template-columns:1fr 1fr}.hero{padding-top:115px}.hero h1{font-size:30vw;margin-top:31vh}.target{width:55vw;right:4%;top:22%}.section-grid{grid-template-columns:1fr}.manifesto{padding:95px 0}.manifesto .kicker{margin-bottom:55px}.columns{padding-left:0;margin-top:55px}.players{padding:95px 0}.players-head{grid-template-columns:1fr}.players-head h2{margin:50px 0 30px}.chair-grid{grid-template-columns:1fr 1fr;gap:50px 16px}.program{padding:95px 0}.program .kicker{margin-bottom:55px}.contact{padding:95px 0}.contact-grid{grid-template-columns:1fr;gap:70px;margin-top:55px}}
	@media(max-width:560px){.hero h1{font-size:29vw;margin-top:36vh}.hero-foot>p{font-size:23px}.arrow-link{width:170px;gap:15px}.target{top:25%;width:68vw}.columns{grid-template-columns:1fr;gap:30px}.chair-grid{grid-template-columns:1fr}.chair-portrait{aspect-ratio:4/4.7}.program li{grid-template-columns:42px 1fr}.program li i{display:none}.program strong{font-size:25px}footer{grid-template-columns:1fr;gap:18px}footer p:nth-child(2),footer p:last-child{text-align:left}}
	@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.motto-track{animation:none}}
</style>
